# Variables de entorno de referencia — copiar a .env (nunca versionar valores reales)
# Nota: los endpoints locales usan 127.0.0.1 (no "localhost") para evitar el intento
# previo a ::1 (IPv6) que en Windows+Docker tarda ~2 s por conexión.

# --- General ---
ENVIRONMENT=local
LOG_LEVEL=INFO
JWT_SECRET=cambiar-en-produccion-minimo-32-caracteres
SERVICE_TOKEN_SECRET=cambiar-en-produccion-minimo-32-caracteres
JWT_ISSUER=platform-identity
JWT_AUDIENCE=platform-api

# --- Identity ---
DATABASE_URL=postgresql+psycopg://platform:platform_local_dev_only@127.0.0.1:5433/platform_identity
REQUIRE_EMAIL_VERIFICATION=true
TRUST_PROXY_HEADERS=true
FLAG_MFA=false
# FLAG_LIVE_TRADING debe permanecer false (REQUIERE LICENCIA/REGULACIÓN)

# --- Audit ---
AUDIT_DATABASE_URL=postgresql+psycopg://platform:platform_local_dev_only@127.0.0.1:5433/platform_audit

# --- Ledger ---
LEDGER_DATABASE_URL=postgresql+psycopg://platform:platform_local_dev_only@127.0.0.1:5433/platform_ledger

# --- Accounts ---
ACCOUNTS_DATABASE_URL=postgresql+psycopg://platform:platform_local_dev_only@127.0.0.1:5433/platform_accounts
DEMO_INITIAL_BALANCE=10000

# --- Eventos (Redpanda; lo usan identity, audit, ledger y accounts) ---
REDPANDA_BOOTSTRAP_SERVERS=127.0.0.1:19092
OUTBOX_RELAY_ENABLED=true
OUTBOX_RELAY_INTERVAL_MS=500
OUTBOX_MAX_ATTEMPTS=5
OUTBOX_BATCH_SIZE=100
EVENT_CONSUMER_ENABLED=true

# --- Gateway ---
IDENTITY_URL=http://127.0.0.1:8081
AUDIT_URL=http://127.0.0.1:8083
MARKET_DATA_URL=http://127.0.0.1:8084
LEDGER_URL=http://127.0.0.1:8085
ACCOUNTS_URL=http://127.0.0.1:8086
CORS_ORIGINS=http://localhost:3000

# --- Infraestructura ---
REDIS_URL=redis://127.0.0.1:6379/0
# Collector OTLP/HTTP del perfil obs (ej. http://127.0.0.1:4318); vacío = sin trazas (ADR-0013, REQ-057)
OTEL_ENDPOINT=
