# Variables de entorno de referencia — copiar a .env (nunca versionar valores reales)

# --- General ---
ENVIRONMENT=local
LOG_LEVEL=INFO
JWT_SECRET=cambiar-en-produccion-minimo-32-caracteres
SERVICE_TOKEN_SECRET=cambiar-en-produccion-minimo-32-caracteres
JWT_ISSUER=platform-identity
JWT_AUDIENCE=platform-api

# --- Identity ---
DATABASE_URL=postgresql+psycopg://platform:platform_local_dev_only@localhost:5433/platform_identity
AUDIT_SERVICE_URL=http://localhost:8083
REQUIRE_EMAIL_VERIFICATION=true
TRUST_PROXY_HEADERS=true
FLAG_MFA=false
# FLAG_LIVE_TRADING debe permanecer false (REQUIERE LICENCIA/REGULACIÓN)

# --- Audit ---
AUDIT_DATABASE_URL=postgresql+psycopg://platform:platform_local_dev_only@localhost:5433/platform_audit

# --- Gateway ---
IDENTITY_URL=http://localhost:8081
AUDIT_URL=http://localhost:8083
CORS_ORIGINS=http://localhost:3000

# --- Infraestructura ---
REDIS_URL=redis://localhost:6379/0
OTEL_ENDPOINT=
