# Despliegue OMV (192.168.1.200) — copiar a .env y completar con valores reales.
#   cp .env.example .env
#   JWT_SECRET=$(openssl rand -hex 32)   etc.  -> NUNCA versionar .env
POSTGRES_USER=platform
POSTGRES_PASSWORD=COMPLETAR-openssl-rand-hex-16
POSTGRES_DB=platform
JWT_SECRET=COMPLETAR-openssl-rand-hex-32
SERVICE_TOKEN_SECRET=COMPLETAR-openssl-rand-hex-32
GRAFANA_PASSWORD=COMPLETAR-password-fuerte
CORS_ORIGINS=http://192.168.1.200:40000
COOKIE_SECURE=false
LOG_LEVEL=INFO
# Telemetría OTLP (requiere perfil obs): http://otel-collector:4318
OTEL_ENDPOINT=
